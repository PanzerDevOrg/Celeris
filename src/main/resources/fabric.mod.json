{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "sources": "https://github.com/PanzerDevOrg/Celeris",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "${mod_banner}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.panzer.mods.celeris.CelerisFabric"],
    "client": ["com.panzer.mods.celeris.CelerisFabric"],
    "modmenu": ["com.panzer.mods.celeris.client.CelerisModMenu"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
